{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    // A rolling file is convenient when developing locally. It is deliberately not
    // configured for other environments: a container runs as a non-root user that
    // cannot create the directory, and its filesystem is discarded on restart, so
    // the console sink is what the platform actually collects.
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/assignment-system-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}
