# =============================================================================
#  Assignment & Submission Management System - environment configuration
# =============================================================================
#  Copy this file to `.env` and fill in real values. `.env` is git-ignored; never
#  commit working credentials.
#
#  Docker Compose reads this file automatically. When running the projects
#  directly (dotnet run / npm run dev) see the README for how to supply these -
#  ASP.NET Core reads them as environment variables, where `__` is the separator
#  for a nested configuration section.
# =============================================================================

# ------------------------------------------------------------------ database
POSTGRES_DB=assignment_system
POSTGRES_USER=assignment_user
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_PORT=5432

# The API's connection string. Host is `postgres` under Docker Compose (the
# service name) and `localhost` when running the API on your machine.
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=assignment_system;Username=assignment_user;Password=change-me-before-running

# Hosted PostgreSQL (Neon, Supabase, Azure, ...) hands out a URI that looks like
#   postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
# Npgsql does NOT understand that form. Rewrite it into keyword form, and keep the
# SSL settings — a managed provider will refuse an unencrypted connection:
#   Host=ep-xxx.aws.neon.tech;Database=neondb;Username=user;Password=password;SSL Mode=Require;Trust Server Certificate=true

# ----------------------------------------------------------------------- JWT
# Signing key for access tokens. Must be at least 32 bytes; the API refuses to
# start otherwise. Generate one with:
#   openssl rand -base64 48
# or, on Windows PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
Jwt__Key=replace-with-a-random-value-of-at-least-32-bytes
Jwt__Issuer=AssignmentSystem
Jwt__Audience=AssignmentSystemClient
Jwt__ExpiryMinutes=480

# ------------------------------------------------------------------- startup
# Apply pending EF Core migrations when the API starts. Convenient locally;
# turn it off in production and run migrations as a deliberate step.
Database__AutoMigrate=true

# Insert the demo dataset (courses, teachers, students, assignments) if it is
# not already present. Set to false for anything other than a demo.
Seed__Enabled=true
Seed__AdminPassword=Admin@123
Seed__TeacherPassword=Teacher@123
Seed__StudentPassword=Student@123

# ---------------------------------------------------------------------- cors
# Origins allowed to call the API. Comma-separated positions map onto the
# Cors:AllowedOrigins array.
Cors__AllowedOrigins__0=http://localhost:3000

# ------------------------------------------------------------------ frontend
# Where the browser should send API requests. Baked in at build time, so it must
# be an address the browser can reach - not a Docker service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# Ports published on the host by Docker Compose.
API_PORT=5080
WEB_PORT=3000
